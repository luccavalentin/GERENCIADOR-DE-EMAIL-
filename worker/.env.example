# Configuração do Sistema (Web + Worker)
# Renomeie para .env e preencha os valores antes de rodar na VPS

# Supabase (Obrigatório)
SUPABASE_URL=https://sua-url.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Worker (Opcional)
# Intervalo em milissegundos entre as verificações (padrão: 60000 = 1 minuto)
CHECK_INTERVAL_MS=60000
